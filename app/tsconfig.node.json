{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src/main/**/*", "src/preload/**/*", "src/shared/**/*",
    "electron.vite.config.ts",
    "src/renderer/src/shared/topicGrade.ts",
    "src/renderer/src/shared/topicMetrics.ts",
    "src/renderer/src/shared/weekDigest.ts"]
}
