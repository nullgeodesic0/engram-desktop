{
  "name": "engram-desktop",
  "version": "0.1.0",
  "description": "A custom desktop app for the Engram Claude Code learning plugin — scripts the claude CLI directly, no API billing.",
  "author": "Tyler Hadsell",
  "license": "MIT",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "check:topic-metrics": "tsx scripts/checkTopicMetricsAgreement.ts",
    "check:punctuality-sanity": "tsx scripts/checkPunctualitySanity.ts",
    "check:grade-trend-sanity": "tsx scripts/checkGradeTrendSanity.ts",
    "check:doctrine": "tsx scripts/checkDoctrine.ts",
    "test": "vitest run",
    "check:ritual-snapshot": "tsx scripts/snapshotRitual.ts",
    "check:plugin-overlay": "tsx scripts/applyPluginOverlays.ts --check",
    "apply:plugin-overlay": "tsx scripts/applyPluginOverlays.ts",
    "icons": "./scripts/build-icons.sh",
    "bundle:bridge-worker": "esbuild src/main/bridge/mcpBridgeWorker.mjs --bundle --platform=node --format=esm --outfile=resources/mcpBridgeWorker.mjs",
    "dist": "npm run bundle:bridge-worker && npm run build && electron-builder",
    "dist:mac": "npm run bundle:bridge-worker && npm run build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/three": "^0.185.1",
    "katex": "^0.18.0",
    "marked": "^18.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.185.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^36.2.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^3.1.0",
    "esbuild": "^0.28.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^5.8.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  },
  "build": {
    "appId": "com.learner.engram-desktop",
    "productName": "Engram Desktop",
    "publish": [
      {
        "provider": "github",
        "owner": "nullgeodesic0",
        "repo": "engram-desktop"
      }
    ],
    "files": [
      "out/**/*"
    ],
    "directories": {
      "buildResources": "build"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "."
      }
    ],
    "mac": {
      "category": "public.app-category.education",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "notarize": false,
      "target": [
        "dmg",
        "zip"
      ],
      "protocols": [
        {
          "name": "Engram Deep Link",
          "schemes": [
            "engram"
          ]
        }
      ]
    },
    "dmg": {
      "title": "Engram Desktop",
      "background": "build/dmg-background.png",
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 178,
          "y": 200,
          "type": "file"
        },
        {
          "x": 482,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "allowScripts": {
    "electron@36.9.5": true,
    "esbuild@0.28.1": true,
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true,
    "electron-winstaller@5.4.0": true
  }
}
