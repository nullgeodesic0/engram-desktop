node_modules/
out/
dist/
build/
# Generated icon/DMG masters are committed so packaging doesn't depend on
# regenerating them (see app/scripts/make-icon.mjs). The directory itself must
# stay ignored-by-default (`app/build/*`, not `!app/build/`) or every future
# electron-builder staging artifact in it becomes stageable.
!app/build/
app/build/*
!app/build/icon.svg
!app/build/icon.png
!app/build/icon.icns
!app/build/icon.ico
!app/build/dmg-background.png
!app/build/entitlements.mac.plist
*.log
.DS_Store
.remember/
spike/
*.tsbuildinfo
.superpowers/

# This repo is meant to stay general for anyone's own use, not carry any
# one learner's actual content — session transcript dumps and backup
# archives are personal/learning-specific by construction, never generic
# project material, so they're excluded by pattern rather than relying on
# everyone remembering not to `git add` them.
session-ses_*.md
*.tar.gz
